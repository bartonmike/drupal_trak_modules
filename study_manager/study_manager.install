<?php

/**
 * @file
 * Install, update and uninstall functions for the study_manager module.
 */

/**
 * Implements hook_install().
 */
function study_manager_install() {
  // Set default configuration values
  $config = \Drupal::configFactory()->getEditable('study_manager.settings');
  $config->set('file_path', 'studies');
  $config->set('max_file_size', '50MB');
  $config->set('allowed_extensions', 'pdf doc docx txt jpg png gif');
  $config->save();
  
  // Create the base directory in private files
  $file_system = \Drupal::service('file_system');
  $directory = 'private://studies';
  $file_system->prepareDirectory($directory, $file_system::CREATE_DIRECTORY | $file_system::MODIFY_PERMISSIONS);
}

/**
 * Implements hook_uninstall().
 */
function study_manager_uninstall() {
  // Remove configuration
  \Drupal::configFactory()->getEditable('study_manager.settings')->delete();
}

/**
 * Implements hook_schema().
 *
 * Maps participant user accounts to studies. Not modeled as a content
 * entity: there's no need for per-mapping canonical URLs, revisions, or
 * translations - just a lightweight, study-scoped linking table. Access to
 * everything that reads/writes it is gated through the owning study's own
 * entity access (see study_manager.routing.yml), not a handler of its own.
 */
function study_manager_schema() {
  $schema['study_participants'] = [
    'description' => 'Maps participant user accounts to studies via a per-study participant ID.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
        'description' => 'Primary key.',
      ],
      'study_id' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'The {study}.id this participant belongs to.',
      ],
      'uid' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'The {users}.uid of the participant account.',
      ],
      'participant_id' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Researcher-assigned ID correlating this participant to rows in study data files.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'description' => 'Timestamp this mapping was created.',
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'study_id' => ['study_id'],
      'uid' => ['uid'],
    ],
    'unique keys' => [
      'study_participant_id' => ['study_id', 'participant_id'],
    ],
  ];

  return $schema;
}

/**
 * Install the Study entity type.
 */
function study_manager_update_8001() {
  \Drupal::entityDefinitionUpdateManager()->installEntityType(\Drupal::entityTypeManager()->getDefinition('study'));
}

/**
 * Install the private upload and shared-library selection fields on Study.
 */
function study_manager_update_8002() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('study');
  $fields = \Drupal\study_manager\Entity\Study::baseFieldDefinitions($entity_type);

  $new_fields = [
    'private_comparison_files',
    'private_reference_files',
    'selected_comparison_files',
    'selected_reference_files',
  ];

  foreach ($new_fields as $field_name) {
    if (isset($fields[$field_name]) && !$update_manager->getFieldStorageDefinition($field_name, 'study')) {
      $update_manager->installFieldStorageDefinition($field_name, 'study', 'study_manager', $fields[$field_name]);
    }
  }

  // The 'files' field was relabeled to "Study Data" and restricted to CSV/XLSX.
  // baseFieldDefinitions() is called directly above (not via the entity field
  // manager), so the returned definitions never got their name/entity type
  // set - updateFieldStorageDefinition() needs that to look up the currently
  // installed definition, or it fails with a null $original.
  if ($update_manager->getFieldStorageDefinition('files', 'study')) {
    $fields['files']->setName('files');
    $fields['files']->setTargetEntityTypeId('study');
    $update_manager->updateFieldStorageDefinition($fields['files']);
  }
}

/**
 * Installs the per-study encryption_key field and backfills existing
 * studies: generates a key for any study that doesn't have one yet, and
 * encrypts any already-uploaded Study Data / Private Comparison Data files
 * that are still plaintext on disk.
 */
function study_manager_update_8003() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('study');
  $fields = \Drupal\study_manager\Entity\Study::baseFieldDefinitions($entity_type);

  if (!$update_manager->getFieldStorageDefinition('encryption_key', 'study')) {
    $update_manager->installFieldStorageDefinition('encryption_key', 'study', 'study_manager', $fields['encryption_key']);
  }

  // Re-saving each study runs Study::preSave() (generates a key if missing)
  // and Study::postSave() (encrypts any plaintext files still on disk).
  $storage = \Drupal::entityTypeManager()->getStorage('study');
  foreach ($storage->loadMultiple() as $study) {
    $study->save();
  }
}

/**
 * Repairs File entities referenced by a Study whose URI still contains a
 * literal, unresolved '[study:id]' token (written before study_manager
 * registered the 'study' token type; see study_manager_token_info() /
 * study_manager_tokens() in study_manager.module), moving them to the
 * correct per-study path.
 */
function study_manager_update_8005() {
  $storage = \Drupal::entityTypeManager()->getStorage('study');
  /** @var \Drupal\Core\File\FileSystemInterface $file_system */
  $file_system = \Drupal::service('file_system');
  $logger = \Drupal::logger('study_manager');

  foreach ($storage->loadMultiple() as $study) {
    /** @var \Drupal\study_manager\Entity\Study $study */
    foreach (['files', 'private_comparison_files', 'private_reference_files'] as $field_name) {
      foreach ($study->get($field_name)->referencedEntities() as $file) {
        /** @var \Drupal\file\FileInterface $file */
        $uri = $file->getFileUri();
        if (strpos($uri, '[study:id]') === FALSE) {
          continue;
        }

        $corrected_uri = str_replace('[study:id]', (string) $study->id(), $uri);

        try {
          $directory = dirname($corrected_uri);
          $file_system->prepareDirectory($directory, $file_system::CREATE_DIRECTORY | $file_system::MODIFY_PERMISSIONS);
          $moved_uri = $file_system->move($uri, $corrected_uri, $file_system::EXISTS_RENAME);
          $file->setFileUri($moved_uri);
          $file->save();
        }
        catch (\Exception $e) {
          $logger->error('Failed to repair file @fid (@uri) for study @study_id: @message', [
            '@fid' => $file->id(),
            '@uri' => $uri,
            '@study_id' => $study->id(),
            '@message' => $e->getMessage(),
          ]);
        }
      }
    }
  }
}

/**
 * Creates the study_participants table on sites that already installed the
 * module before it existed. Inlines the schema spec (rather than calling
 * study_manager_schema()) so this update keeps working the same way even if
 * the schema function itself changes later.
 */
function study_manager_update_8006() {
  $schema = \Drupal::database()->schema();

  if (!$schema->tableExists('study_participants')) {
    $schema->createTable('study_participants', [
      'description' => 'Maps participant user accounts to studies via a per-study participant ID.',
      'fields' => [
        'id' => [
          'type' => 'serial',
          'not null' => TRUE,
          'description' => 'Primary key.',
        ],
        'study_id' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'The {study}.id this participant belongs to.',
        ],
        'uid' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'The {users}.uid of the participant account.',
        ],
        'participant_id' => [
          'type' => 'varchar',
          'length' => 64,
          'not null' => TRUE,
          'description' => 'Researcher-assigned ID correlating this participant to rows in study data files.',
        ],
        'created' => [
          'type' => 'int',
          'not null' => TRUE,
          'description' => 'Timestamp this mapping was created.',
        ],
      ],
      'primary key' => ['id'],
      'indexes' => [
        'study_id' => ['study_id'],
        'uid' => ['uid'],
      ],
      'unique keys' => [
        'study_participant_id' => ['study_id', 'participant_id'],
      ],
    ]);
  }
}

/**
 * Creates the "Study Participant" role assigned to accounts created via the
 * participant mapping upload (see ParticipantUploadForm).
 */
function study_manager_update_8007() {
  if (!\Drupal\user\Entity\Role::load('study_participant')) {
    \Drupal\user\Entity\Role::create([
      'id' => 'study_participant',
      'label' => 'Study Participant',
    ])->save();
  }
}

/**
 * Enables the per-file "description" widget on the study file fields, so
 * researchers can add a caption (e.g. "Participant results") shown on the
 * study page. The 'description' column already exists in the file field's
 * schema regardless of this setting - this only formalizes the field
 * definition change; updateFieldStorageDefinition() needs the definition to
 * know its own name (see study_manager_update_8002()).
 */
function study_manager_update_8008() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('study');
  $fields = \Drupal\study_manager\Entity\Study::baseFieldDefinitions($entity_type);

  foreach (['files', 'private_comparison_files', 'private_reference_files'] as $field_name) {
    if ($update_manager->getFieldStorageDefinition($field_name, 'study')) {
      $fields[$field_name]->setName($field_name);
      $fields[$field_name]->setTargetEntityTypeId('study');
      $update_manager->updateFieldStorageDefinition($fields[$field_name]);
    }
  }
}

/**
 * Installs the study_manager_title / study_manager_description base fields
 * on the core File entity (see study_manager_entity_base_field_info()).
 */
function study_manager_update_8009() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('file');

  foreach (['study_manager_title', 'study_manager_description'] as $field_name) {
    if (isset($fields[$field_name]) && !$update_manager->getFieldStorageDefinition($field_name, 'file')) {
      $update_manager->installFieldStorageDefinition($field_name, 'file', 'study_manager', $fields[$field_name]);
    }
  }
}

/**
 * Installs the study_manager_first_name / study_manager_last_name /
 * study_manager_phone / study_manager_address base fields on the core User
 * entity (see study_manager_entity_base_field_info()), populated for
 * participants via ParticipantUploadForm and shown on the study participant
 * list (see StudyParticipantController).
 */
function study_manager_update_8010() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $fields = \Drupal::service('entity_field.manager')->getBaseFieldDefinitions('user');

  $new_fields = [
    'study_manager_first_name',
    'study_manager_last_name',
    'study_manager_phone',
    'study_manager_address',
  ];

  foreach ($new_fields as $field_name) {
    if (isset($fields[$field_name]) && !$update_manager->getFieldStorageDefinition($field_name, 'user')) {
      $update_manager->installFieldStorageDefinition($field_name, 'user', 'study_manager', $fields[$field_name]);
    }
  }
}

/**
 * Installs the shared_studies field on Study, holding the global.yaml
 * project IDs added from the shared studies page (see
 * SharedStudiesController).
 */
function study_manager_update_8011() {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $entity_type = \Drupal::entityTypeManager()->getDefinition('study');
  $fields = \Drupal\study_manager\Entity\Study::baseFieldDefinitions($entity_type);

  if (!$update_manager->getFieldStorageDefinition('shared_studies', 'study')) {
    $update_manager->installFieldStorageDefinition('shared_studies', 'study', 'study_manager', $fields['shared_studies']);
  }
}
